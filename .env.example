# ── Security ────────────────────────────────────────────────
# Secret used to sign session cookies. REQUIRED in production (>= 32 random chars).
# If unset in dev, one is generated into data/.auth-secret (git-ignored).
AUTH_SECRET=

# DEMO_MODE is OFF by default. DEMO_MODE=true shows one-click demo logins + lets brokers see the OTP.
# Only for a private demo machine together with SEED_DEMO_DATA=true. NEVER enable on a public server.
DEMO_MODE=false
DEMO_PASSWORD=Genz@2026
SEED_DEMO_DATA=false

# First administrator (created on an empty database). If the password is empty, a random one is printed once in the log.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=admin@yourcompany.in
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=

# ── Network ─────────────────────────────────────────────────
HOST=127.0.0.1
PORT=3000
# Set to "true" (or a hop count) when running behind a reverse proxy so rate-limits use the real client IP.
TRUST_PROXY=

# ── SMS (site-visit OTP delivery) ───────────────────────────
# POST {to, message} with Bearer token. If unset, SMS is simulated in the server console.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Legal pages: court jurisdiction shown in Terms (build-time, optional)
# VITE_LEGAL_JURISDICTION="Raipur, Chhattisgarh"
# VITE_LEGAL_JURISDICTION_HI="रायपुर (छत्तीसगढ़)"

# v25 KYC vault: key that encrypts full Aadhaar + address. 64 hex chars (openssl rand -hex 32).
# PRODUCTION: set this and keep a SEPARATE backup of it. Lose the key = the sealed values can never be opened again.
# Empty = a key file data/.kyc-vault.key is created on first start (fine for a single server, not for containers without a volume).
KYC_VAULT_KEY=

# v26 — phone alerts (Web Push, free). Generate once and keep: a new key means everyone must turn alerts on again.
#   node -e "const c=require('crypto').createECDH('prime256v1');c.generateKeys();console.log('VAPID_PUBLIC_KEY='+c.getPublicKey('base64url')+'\nVAPID_PRIVATE_KEY='+c.getPrivateKey('base64url'))"
# Empty = a key file data/.vapid.json is created on first start.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# who runs this server (push services may contact it): mailto:you@domain or https://your-domain
VAPID_SUBJECT=
# the public address of the app (used in the owner-consent link sent on WhatsApp), e.g. https://network.genzbuildcon.com
PUBLIC_URL=
