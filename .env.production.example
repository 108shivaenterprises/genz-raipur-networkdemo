# Production settings for the Docker + PostgreSQL stack (docker-compose.yml). PLACEHOLDERS ONLY.
# Usage: cp .env.production.example .env  (on the server), fill in, never commit the real .env.
# Variables marked REQUIRED make `docker compose up` / the server refuse to start when missing.

# ---- Domain and address (REQUIRED) ----
DOMAIN=network.example.com              # Caddy gets the HTTPS certificate for this name
PUBLIC_URL=https://network.example.com  # every SMS / QR / inlet / consent link is built from this, never from the Host header

# ---- Database (REQUIRED) ----
DB_PASSWORD=change-me-long-random       # use `openssl rand -hex 24` (letters/digits only: it goes raw into the postgres:// URL, so @ : / # % break it)
# DATABASE_URL is NOT read from this file: compose hardcodes postgres://genz:<DB_PASSWORD>@db:5432/genz.
# For an external Postgres, edit DATABASE_URL under `app:` in docker-compose.yml (and drop the db service).

# ---- Secrets (REQUIRED) ----
AUTH_SECRET=                            # openssl rand -hex 32  (>= 32 chars) signs login cookies; changing it logs everyone out
KYC_VAULT_KEY=                          # openssl rand -hex 32  keeps sealed KYC values; LOSING IT = sealed values unreadable. Back it up away from the server.
# KYC_VAULT_DISABLED=true               # the explicit alternative: run with the KYC vault OFF on purpose (D2: no full Aadhaar kept)
AUDIT_HMAC_KEY=                         # openssl rand -hex 32 (>= 24 chars) signs the audit chain; if empty it is derived from AUTH_SECRET

# ---- First admin ----
ADMIN_EMAIL=admin@genzbuildcon.com      # becomes SEED_ADMIN_EMAIL (SEED_ADMIN_EMAIL wins if both are set)
SEED_ADMIN_NAME=
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=                    # empty = a one-time password is printed in `docker compose logs app`; forced change on first login

# ---- Company and legal notice ----
COMPANY_NAME=GENZ BUILDCON INFRA PVT LTD
COMPANY_ADDRESS=Raipur, Chhattisgarh, India
GRIEVANCE_NAME=                         # Grievance Officer (DPDP / IT Rules) shown in the privacy notice
GRIEVANCE_EMAIL=
GRIEVANCE_PHONE=

# ---- Feature switches (see DECISIONS.md) ----
FEATURE_VOICE=false                     # D1: in-app calls + speech-to-text mic. Keep false until a TURN server and privacy wording exist
OTP_MODE=manual                         # D5: manual (WhatsApp click-to-chat / admin screen) | sms
DIGILOCKER_MODE=manual-review           # D2: off | manual-review | live (live needs DigiLocker partner credentials)

# ---- Optional ----
# VAPID_PUBLIC_KEY=                     # web push keys (npx web-push generate-vapid-keys); empty = a key file in the data volume
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# SMS_WEBHOOK_URL=                      # only with OTP_MODE=sms / SMS reminders
# SMS_WEBHOOK_TOKEN=
# APP_MEM_LIMIT=1g                      # container memory cap
# NODE_OPTIONS=--max-old-space-size=768 # keep below APP_MEM_LIMIT
